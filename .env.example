PROJECT_NAME="Quantum Tutor Chatbot API"
DESCRIPTION="Chatbot tutor de computação quântica com RAG e multi‑agentes"
VERSION=0.1.0
API_V1_STR=/api/v1

STAGE=local
DEBUG=true
LOG_LEVEL=DEBUG

BACKEND_CORS_ORIGINS=http://localhost:3000

JWT_SECRET=quantum_tutor_jwt_secret_key_2024
SECRET_KEY=SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=qt-chatbot

POSTGRES_HOST=postgres
# POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantum_chat

REDIS_HOST=redis
REDIS_PORT=6379

DYNAMODB_REGION=sa-east-1
DYNAMODB_TABLE_MESSAGES=

USE_BEDROCK=false
USE_LOCAL_MODEL=true
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_ROLE_ARN=

EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=./vectorstore
