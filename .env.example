# ─────────────────────────── app metadata ───────────────────────────
PROJECT_NAME="Quantum Tutor Chatbot API"
DESCRIPTION="Chatbot tutor de computação quântica com RAG e multi‑agentes"
VERSION=0.1.0
API_V1_STR=/api/v1

# ─────────────────────────── runtime ────────────────────────────────
APP_ENV=local          
DEBUG=true
LOG_LEVEL=DEBUG

# ─────────────────────────── CORS ───────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000

# ────────────────────────── security ───────────────────────────────
JWT_SECRET=quantum_tutor_jwt_secret_key_2024
SECRET_KEY=SECRET_KEY          
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─────────────────────────── AWS (opcional) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=qt-chatbot

# ───────────────────── bancos & cache (local) ──────────────────────
POSTGRES_HOST=postgres
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantum_chat

REDIS_HOST=redis
REDIS_PORT=6379

# URLs prontos (opcionais – prefixos)
# POSTGRES_URL_PREFIX=postgresql://postgres:postgres@localhost:5432/quantum_chat
# REDIS_URL_PREFIX=redis://localhost:6379/0

# ───────────────────────── DynamoDB (se usar) ──────────────────────
DYNAMODB_REGION=sa-east-1
DYNAMODB_TABLE_MESSAGES=

# ─────────────────── LLM / RAG (opções) ────────────────────────────
USE_BEDROCK=false
USE_LOCAL_MODEL=true
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_ROLE_ARN=

EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=./vectorstore
